generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Application{
  id  String @id @default(cuid())
  company String
  role String
  location String
  status String
  appliedOn DateTime
  notes String?
  createdAt DateTime @default(now())
  updateAt DateTime @updatedAt  
}